-- ===================== HTTP HELPER =====================
local function httpGet(url)
    if syn and syn.request then return syn.request({Url = url, Method = "GET"}) end
    if request then return request({Url = url, Method = "GET"}) end
    if http_request then return http_request({Url = url, Method = "GET"}) end
    return nil
end

local function httpPut(url, jsonData)
    local body = HttpService:JSONEncode(jsonData)
    if syn and syn.request then
        return syn.request({Url = url, Method = "PUT", Headers = {["Content-Type"] = "application/json"}, Body = body})
    elseif request then
        return request({Url = url, Method = "PUT", Headers = {["Content-Type"] = "application/json"}, Body = body})
    elseif http_request then
        return http_request({Url = url, Method = "PUT", Headers = {["Content-Type"] = "application/json"}, Body = body})
    end
    return nil
end

local function httpDelete(url)
    if syn and syn.request then return syn.request({Url = url, Method = "DELETE"}) end
    if request then return request({Url = url, Method = "DELETE"}) end
    if http_request then return http_request({Url = url, Method = "DELETE"}) end
    return nil
end

-- ===================== LIVE‑USER‑SYSTEM =====================
local activeUsers = 0

-- Spieler zur aktiven Liste hinzufügen
local function addActiveUser()
    local url = FIREBASE_DB .. "/active_users/" .. LocalPlayer.UserId .. ".json"
    local data = {
        name = LocalPlayer.Name,
        joined = os.date("%Y-%m-%d %H:%M:%S")
    }
    pcall(function() httpPut(url, data) end)
end

-- Spieler aus der aktiven Liste entfernen
local function removeActiveUser()
    local url = FIREBASE_DB .. "/active_users/" .. LocalPlayer.UserId .. ".json"
    pcall(function() httpDelete(url) end)
end

-- Log‑Eintrag schreiben, wenn jemand das Script schließt
local function logCloseEvent()
    local url = FIREBASE_DB .. "/close_logs.json"
    local data = {
        name = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        timestamp = os.date("%Y-%m-%d %H:%M:%S")
    }
    -- Firebase POST (push) mit generierter ID – wir verwenden PUT mit eigenem Key
    local closeUrl = FIREBASE_DB .. "/close_logs/" .. HttpService:GenerateGUID(false) .. ".json"
    pcall(function() httpPut(closeUrl, data) end)
end

-- Anzahl der aktiven Nutzer abrufen
local function updateActiveUserCount()
    local url = FIREBASE_DB .. "/active_users.json"
    local result = httpGet(url)
    if result and result.Body then
        local data = HttpService:JSONDecode(result.Body)
        if data then
            local count = 0
            for _ in pairs(data) do count = count + 1 end
            activeUsers = count
        end
    end
end

