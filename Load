local spawnPoints = {
    CFrame.new(-119.644211, -677.249939, 1139.98853),
    CFrame.new(1449.4, -665.0, 1053.3)
}
local spawnRadius = 500

-- ===================== HILFSFUNKTIONEN =====================
local function hasTeammateLabel(plr)
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        return plr.Character.HumanoidRootPart:FindFirstChild("TeammateLabel")
    end
end

local function nearSpawn()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local pos = LocalPlayer.Character.HumanoidRootPart.Position
        for _, sp in ipairs(spawnPoints) do
            if (pos - sp.Position).Magnitude < spawnRadius then return true end
        end
    end
    return false
end

local function hasClearSight(target)
    if not (target and target.Character and target.Character:FindFirstChild("Head")) then return false end
    local head = target.Character.Head
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin).Unit * 1000
    local ray = Ray.new(origin, direction)
    local ignoreList = {}
    if LocalPlayer.Character then ignoreList = {LocalPlayer.Character} end
    local hitPart = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList, false, true)
    return hitPart and hitPart:IsDescendantOf(target.Character)
end

local function getTarget()
    local closestDist = math.huge
    local closestPlr
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            local health = humanoid and humanoid.Health or 0
            if health > 0 and not hasTeammateLabel(plr) and hasClearSight(plr) then
                local dist = (plr.Character.Head.Position - Camera.CFrame.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlr = plr
                end
            end
        end
    end
    return closestPlr
end

-- Silent Aim
local storedCamCF
Mouse.Button1Down:Connect(function()
    if SilentAimEnabled and not nearSpawn() and Camera then
        local target = getTarget()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            storedCamCF = Camera.CFrame
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end
end)
Mouse.Button1Up:Connect(function()
    if SilentAimEnabled and storedCamCF then
        Camera.CFrame = storedCamCF
        storedCamCF = nil
    end
end)

-- Autoclicker
local lastClick = 0
local function click()
    if mouse1click then pcall(mouse1click) return end
    local vim = (cloneref and cloneref(game:GetService("VirtualInputManager"))) or game:GetService("VirtualInputManager")
    if vim then
        vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 1)
        vim:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 1)
    else
        pcall(function()
            UserInputService:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 1)
            UserInputService:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 1)
        end)
    end
end
RunService.Heartbeat:Connect(function()
    if AutoClickerEnabled and UserInputService:IsMouseButtonPressed(AutoClickerKey) then
        local now = tick()
        if now - lastClick >= 1 / AutoClickerCPS then
            click()
            lastClick = now
        end
    end
end)

